{
    "name": "tiltakspenger-meldekort",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.27.1",
    "scripts": {
        "prepare": "husky",
        "dev": "pnpm --filter @meldekort/server dev",
        "start": "pnpm --filter @meldekort/server deploy-and-start",
        "build": "pnpm --filter @meldekort/client build && pnpm --filter @meldekort/server build",
        "lbt": "pnpm run lint && pnpm run build && pnpm test",
        "lint": "pnpm run /^lint:/",
        "lint:tsc-client": "pnpm --filter @meldekort/client tsc",
        "lint:tsc-server": "pnpm --filter @meldekort/server tsc",
        "lint:eslint": "eslint --cache --cache-location node_modules/.cache/eslint/ \"**/*.ts\" \"**/*.tsx\"",
        "test": "playwright test",
        "test:ui": "playwright test --ui"
    },
    "comments": "Husk å holde imaget i GHA workflow i sync med playwright-versjonen i devDependencies",
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@eslint/compat": "2.1.1",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@types/node": "26.6.2",
        "@typescript-eslint/eslint-plugin": "8.70.1",
        "@typescript-eslint/parser": "8.70.1",
        "dotenv": "18.0.3",
        "eslint": "10.11.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-css-modules": "2.12.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "husky": "9.1.7",
        "lint-staged": "17.5.1",
        "playwright": "1.63.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint"
        ],
        "*.{ts,tsx,css}": [
            "prettier --write"
        ]
    }
}
