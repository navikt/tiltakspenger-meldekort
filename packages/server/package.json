{
    "name": "@meldekort/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "build-and-watch": "node build.mjs watch",
        "start": "DOTENV_CONFIG_PATH=../.env node -r dotenv/config ./dist/server.cjs",
        "deploy-and-start": "cd ../.. && pnpm deploy --filter @meldekort/server --prod --force deploy && cp -r packages/server/dist deploy/dist && cd deploy && NODE_ENV=production pnpm start",
        "nodemon-start": "DOTENV_CONFIG_PATH=../../.env.development nodemon -r dotenv/config -w ./dist/server.cjs -w ../../.env.development ./dist/server.cjs",
        "dev": "concurrently -n esbuild,nodemon -c blue,green -k \"pnpm run build-and-watch\" \"pnpm run nodemon-start\"",
        "tsc": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/server.tsbuildinfo"
    },
    "dependencies": {
        "@meldekort/common": "workspace:*",
        "@navikt/nav-dekoratoren-moduler": "4.5.0",
        "@navikt/oasis": "4.2.2",
        "compression": "1.8.2",
        "csp-header": "6.4.0",
        "dayjs": "1.11.23",
        "dotenv": "18.0.3",
        "express": "5.2.1",
        "http-terminator": "3.2.0",
        "sirv": "3.0.2"
    },
    "devDependencies": {
        "@types/compression": "1.8.1",
        "@types/express": "5.0.6",
        "concurrently": "10.0.5",
        "esbuild": "0.28.2",
        "nodemon": "3.1.14",
        "vite": "8.3.1"
    },
    "nodemonConfig": {
        "delay": 500
    }
}
