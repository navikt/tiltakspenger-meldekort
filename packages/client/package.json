{
    "name": "@meldekort/client",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm run build:client && pnpm run build:ssr",
        "build:client": "vite build --outDir ../server/dist/client",
        "build:ssr": "vite build --ssr src/main-server.tsx --outDir ../server/src/_ssr-dist --emptyOutDir false",
        "tsc": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/tsc/client.tsbuildinfo"
    },
    "dependencies": {
        "@meldekort/common": "workspace:*",
        "@navikt/aksel-icons": "8.18.0",
        "@navikt/ds-css": "8.18.0",
        "@navikt/ds-react": "8.18.0",
        "@navikt/nav-dekoratoren-moduler": "4.5.0",
        "dayjs": "1.11.23",
        "preact": "10.29.8",
        "preact-render-to-string": "6.7.0",
        "swr": "2.5.1",
        "wouter": "3.11.1"
    },
    "devDependencies": {
        "@preact/preset-vite": "2.10.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "rollup-plugin-visualizer": "7.1.1",
        "vite": "8.3.1"
    }
}
